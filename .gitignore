__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store

# Build artefacts from `pip install -e .` and `python -m build`.
*.egg-info/
build/
dist/

# Local ruff cache; the lint config lives in pyproject.toml.
.ruff_cache/

# Node + ESLint toolchain (only used by the lint-js CI job; the
# dashboard's one runtime dependency, lit-html, is vendored under
# web/assets/js/vendor/, so node_modules is never needed at runtime).
node_modules/

# Generated dashboard payloads. All four (metrics.json, diffs.json,
# network.json, asn-names.json) are built fresh on every Pages deploy
# from bitcoin-core/asmap-data, the public snapshots on the
# network-snapshots release, and bgp.tools; see README for the regen
# commands used locally.
/web/assets/data/*.json
.firecrawl/

# Local checkout of bitcoin-core/asmap-data used to run the pipeline; it
# carries its own git history and is cloned fresh on deploy, never tracked.
/asmap-data/

# Local copies of node snapshots and WHOIS caches. Both carry raw node IP
# addresses and must never be committed or published; public payloads contain
# aggregate metrics only. See README for the regen command and cache layout.
/snapshots/
/cache/whois/
